<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>Quartz.DynamoDB</RootNamespace>
    <AssemblyName>QuartzNET-DynamoDB</AssemblyName>
    <Version>1.0.0</Version> <!-- Placeholder, assuming this is managed elsewhere e.g. VersionInfo.cs or build server -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Description>A Quartz.NET Job Store persistence provider for AWS DynamoDB.</Description>
    <!-- Authors, Company, Copyright etc. can be added here or in VersionInfo.cs -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RunCodeAnalysis>false</RunCodeAnalysis> <!-- Set to false initially, can be enabled later if needed with updated analyzers -->
    <NoWarn>$(NoWarn);CS1591</NoWarn> <!-- Suppress missing XML comment warnings for now -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DocumentationFile>bin\Release\net6.0\QuartzNET-DynamoDB.xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.DynamoDBv2" Version="3.7.301" />
    <PackageReference Include="Common.Logging" Version="3.4.1" />     <!-- From prompt, will attempt update later -->
    <PackageReference Include="Common.Logging.Core" Version="3.4.1" />  <!-- From prompt, will attempt update later -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />    <!-- From prompt, will attempt update later -->
    <PackageReference Include="Polly" Version="8.5.2" />             <!-- From prompt, will attempt update later -->
    <PackageReference Include="Quartz" Version="3.14.0" />             <!-- From prompt, will attempt update later -->
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\VersionInfo.cs">
      <Link>Properties\VersionInfo.cs</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Include="job_scheduling_data_2_0.xsd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="QuartzNET-DynamoDB.nuspec" />
  </ItemGroup>

</Project>
